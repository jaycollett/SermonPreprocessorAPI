# Copy to `.env` beside runIt.sh and fill in the real value:
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# `.env` is gitignored and must never be committed. runIt.sh sources it and
# refuses to launch if API_KEY is missing or blank, before it stops the
# running container. The app also refuses to start without it.
#
# An already-exported API_KEY wins over the file.

# HTTP basic-auth password clients (SermonOrchestrator's SERMON_FETCHING_API_KEY)
# must send to GET /sermons and GET /download/<id>.
API_KEY=
